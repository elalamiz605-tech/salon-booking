# PostgreSQL connection string (Neon). Leave empty locally to use the embedded PGlite database.
DATABASE_URL=
# Where the embedded PGlite database is stored when DATABASE_URL is empty.
PGLITE_DIR=.data/pglite
# "true" on the public demo: shows demo credentials, resets data hourly, sends no email.
DEMO_MODE=false
# Password shown on the demo login page (demo mode only).
DEMO_ADMIN_PASSWORD=rizo-demo
# The salon admin's login email.
ADMIN_EMAIL=owner@example.com
# bcrypt hash of the admin password: node scripts/hash-password.mjs "your password"
ADMIN_PASSWORD_HASH=
# Random string of at least 32 characters used to sign admin sessions.
SESSION_SECRET=
# Resend API key. Leave empty to print emails to the server log instead.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Rizo Studio <hola@rizostudio.es>".
EMAIL_FROM=
# Shared secret that the Vercel cron sends to /api/cron/maintenance.
CRON_SECRET=
# Public base URL used in email links, e.g. https://rizostudio.vercel.app
APP_URL=http://localhost:3000
